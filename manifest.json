{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "Needle",
  "version": "1.0.3",
  "description": "__MSG_extDesc__",
  "default_locale": "en",
  "minimum_chrome_version": "127",
  "action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_extActionTitle__",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel",
    "contextMenus"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+N"
      },
      "description": "__MSG_extCommandOpen__"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' data: https: http:;"
  },
  "side_panel": {
    "default_path": "popup.html"
  }
}
